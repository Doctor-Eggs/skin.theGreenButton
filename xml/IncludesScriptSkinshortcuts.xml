<?xml version="1.0" encoding="UTF-8"?>
<includes>

	<include name="SlideWithList211">
		<animation effect="slide" end="0,65" condition="Integer.IsGreater(Container(211).Position,0)">Conditional</animation>
		<animation effect="slide" end="0,65" condition="Integer.IsGreater(Container(211).Position,1)">Conditional</animation>
		<animation effect="slide" end="0,65" condition="Integer.IsGreater(Container(211).Position,2)">Conditional</animation>
		<animation effect="slide" end="0,65" condition="Integer.IsGreater(Container(211).Position,3)">Conditional</animation>
		<animation effect="slide" end="0,65" condition="Integer.IsGreater(Container(211).Position,4)">Conditional</animation>
		<animation effect="slide" end="0,65" condition="Integer.IsGreater(Container(211).Position,5)">Conditional</animation>
		<animation effect="slide" end="0,65" condition="Integer.IsGreater(Container(211).Position,6)">Conditional</animation>
		<animation effect="slide" end="0,65" condition="Integer.IsGreater(Container(211).Position,7)">Conditional</animation>
		<animation effect="slide" end="0,65" condition="Integer.IsGreater(Container(211).Position,8)">Conditional</animation>
		<animation effect="slide" end="0,65" condition="Integer.IsGreater(Container(211).Position,9)">Conditional</animation>
	</include>

	<!-- Checked-box icon when item is enabled; empty-box when disabled -->
	<variable name="SkinShortcutsDisabledIcon">
		<value condition="String.IsEqual(Container(211).ListItem.Property(skinshortcuts-disabled),True)">&#xE835;</value>
		<value>&#xE834;</value>
	</variable>

	<!-- Checkbox icon for itemlayout/focusedlayout (uses ListItem scope) -->
	<variable name="SkinShortcutsDisabledPrefix">
		<value condition="String.IsEqual(ListItem.Property(skinshortcuts-disabled),True)">&#xE835;</value>
		<value>&#xE834;</value>
	</variable>

	<!-- Action label for button 313 — flips with item state -->
	<variable name="SkinShortcutsItemStateLabel">
		<value condition="String.IsEqual(Container(211).ListItem.Property(skinshortcuts-disabled),True)">Enable item</value>
		<value>Disable item</value>
	</variable>

	<!-- Shared chrome for the editor window.
	     Mirrors DialogBackgroundFull but uses kodi-button.png on the upper left
	     instead of the dynamic addon icon, and hard-codes "Media Center Studio"
	     as the title. -->
	<include name="EditorChrome">
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
			<texture fallback="special://skin/backgrounds/SKINDEFAULT.png">$INFO[Skin.String(MasterCustomBackgroundPath)]</texture>
		</control>
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>150</height>
			<texture colordiffuse="66000000">common/blankWhite.png</texture>
		</control>
		<control type="image">
			<left>0</left>
			<top>150r</top>
			<width>1920</width>
			<height>150</height>
			<texture colordiffuse="66000000">common/blankWhite.png</texture>
		</control>
		<control type="image">
			<left>30</left>
			<top>5</top>
			<width>140</width>
			<height>140</height>
			<aspectratio>keep</aspectratio>
			<texture>kodi-button.png</texture>
		</control>
		<control type="image">
			<left>285r</left>
			<top>85</top>
			<width>50</width>
			<height>50</height>
			<aspectratio aligny="top" align="left">keep</aspectratio>
			<texture>kodi-button.png</texture>
		</control>
		<control type="label">
			<right>295</right>
			<top>100</top>
			<width>300</width>
			<height>15</height>
			<align>right</align>
			<aligny>center</aligny>
			<font>font30_light</font>
			<textcolor>white</textcolor>
			<label>[B]Kodi[/B] Media Center</label>
		</control>
		<control type="label">
			<left>200</left>
			<top>90</top>
			<width>1300</width>
			<height>30</height>
			<font>font36</font>
			<label>Media Center Studio</label>
			<align>left</align>
			<aligny>center</aligny>
			<textcolor>lightblue</textcolor>
		</control>
	</include>

	<!-- Help text for whichever button or list currently has focus. -->
	<variable name="EditorButtonDescription">
		<value condition="Control.HasFocus(211)">Select an item from the list, then press right to edit it</value>
		<value condition="Control.HasFocus(308)">Restore — Returns this item to its default label and icon</value>
		<value condition="Control.HasFocus(302)">Delete — Permanently removes this item</value>
		<value condition="Control.HasFocus(301)">Add — Adds a new item to this menu</value>
		<value condition="Control.HasFocus(303)">Move Up — Moves this item higher in the list</value>
		<value condition="Control.HasFocus(304)">Move Down — Moves this item lower in the list</value>
		<value condition="Control.HasFocus(313)">Enable / Disable — Hides or shows this item without deleting it</value>
		<value condition="Control.HasFocus(401)">Choose Shortcut — Select a new destination for this item</value>
		<value condition="Control.HasFocus(305)">Rename — Edit the display name for this item</value>
		<value condition="Control.HasFocus(307)">Change Action — Set the path or action this item triggers</value>
		<value condition="Control.HasFocus(306)">Set Icon — Choose the icon for this item</value>
		<value condition="Control.HasFocus(406)">Set Unfocused Icon — Choose the icon shown when this submenu item is not selected</value>
		<value condition="Control.HasFocus(405)">Edit Submenu — Open the submenu editor for this item</value>
	</variable>

</includes>
