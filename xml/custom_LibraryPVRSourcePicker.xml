<?xml version="1.0" encoding="UTF-8"?>
<window id="1115" type="dialog">
	<defaultcontrol always="true">5001</defaultcontrol>
	<include>dialogeffect</include>
	<controls>
		<!-- Dimmed overlay -->
		<control type="image">
			<left>0</left>
			<top>0</top>
			<width>1920</width>
			<height>1080</height>
			<texture colordiffuse="AA000000">common/white.png</texture>
		</control>
		<!-- Title -->
		<control type="label">
			<left>660</left>
			<top>310</top>
			<width>600</width>
			<height>50</height>
			<font>font30</font>
			<textcolor>lightblue</textcolor>
			<align>center</align>
			<aligny>center</aligny>
			<label>Select Library PVR Playlist</label>
		</control>
		<!-- Playlist list - populated from user's video playlists -->
		<control type="list" id="5001">
			<left>660</left>
			<top>370</top>
			<width>600</width>
			<height>300</height>
			<onleft>5001</onleft>
			<onright>5001</onright>
			<onup>5001</onup>
			<ondown>5001</ondown>
			<!-- onclick fires when user presses OK on any playlist in the list -->
			<onclick>Skin.SetString(LibraryPVRSource,$INFO[ListItem.Label])</onclick>
			<onclick>Dialog.Close(1115)</onclick>
			<content>special://profile/playlists/video/</content>
			<itemlayout height="50" width="600">
				<control type="label">
					<left>10</left>
					<width>580</width>
					<height>50</height>
					<font>font16</font>
					<textcolor>99FFFFFF</textcolor>
					<aligny>center</aligny>
					<label>$INFO[ListItem.Label]</label>
				</control>
			</itemlayout>
			<focusedlayout height="50" width="600">
				<control type="image">
					<width>600</width>
					<height>51</height>
					<texture border="0,2,0,2" colordiffuse="33000000">common/blankWhite.png</texture>
				</control>
				<control type="label">
					<left>10</left>
					<width>580</width>
					<height>50</height>
					<font>font16</font>
					<textcolor>white</textcolor>
					<aligny>center</aligny>
					<label>$INFO[ListItem.Label]</label>
				</control>
			</focusedlayout>
		</control>
	</controls>
</window>
