			</itemlayout>
			<!-- top 65px = button/textbox overlay zone, bottom 190px = submenu preview zone -->
			<focusedlayout width="1150" height="255">
				<control type="image">
					<left>0</left>
					<top>0</top>
					<width>1150</width>
					<height>255</height>
					<texture border="5" colordiffuse="33FFFFFF">common/blankWhite.png</texture>
				</control>
			</focusedlayout>
		</control>

