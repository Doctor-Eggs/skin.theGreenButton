<?xml version="1.0" encoding="UTF-8"?>
<includes>

	<!-- Mainmenu-specific editor content: submenu thumbnail preview panels.
	     These are the only controls that differ between the mainmenu layout and
	     any other group. List 211, scrollbar 260, and grouplist 90000 are defined
	     once in script-skinshortcuts.xml and shared by all layouts.
	     Each fixedlist's labelID condition makes it self-suppress when not editing
	     the mainmenu (submenu item labelIDs never match these mainmenu section names). -->
	<include name="MainMenuEditorLayout">

		<control type="fixedlist" id="90003">
			<include>SubmenuFixedListBase</include>
			<visible>String.IsEqual(Container(211).ListItem.Property(labelID),weather)</visible>
			<content><include>skinshortcuts-group-weather</include></content>
		</control>
		<control type="fixedlist" id="90004">
			<include>SubmenuFixedListBase</include>
			<visible>String.IsEqual(Container(211).ListItem.Property(labelID),pictures)</visible>
