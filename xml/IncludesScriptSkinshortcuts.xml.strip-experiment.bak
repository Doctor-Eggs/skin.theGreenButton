			<left>1270</left><top>323</top><width>190</width><height>52</height>
			<texture colordiffuse="CCFFFFFF">common/blankWhite.png</texture>
		</control>
		<control type="label">
			<visible>Integer.IsEqual(Container(211).Position,3)</visible>
			<left>1270</left><top>323</top><width>190</width><height>52</height>
			<label>$INFO[Container(211).ListItem.Label]</label>
			<font>font13</font><textcolor>FF1A237E</textcolor>
			<align>center</align><aligny>center</aligny><scroll>false</scroll>
		</control>

		<control type="image">
			<visible>Integer.IsEqual(Container(211).Position,4)</visible>
			<left>1460</left><top>155</top><width>190</width><height>220</height>
			<texture border="5" colordiffuse="33FFFFFF">common/blankWhite.png</texture>
		</control>
		<control type="image">
			<visible>Integer.IsEqual(Container(211).Position,4)</visible>
			<left>1470</left><top>160</top><width>170</width><height>163</height>
			<texture fallback="DefaultShortcut.png">$INFO[Container(211).ListItem.Icon]</texture>
			<aspectratio>keep</aspectratio>
		</control>
		<control type="image">
			<visible>Integer.IsEqual(Container(211).Position,4)</visible>
			<left>1460</left><top>323</top><width>190</width><height>52</height>
			<texture colordiffuse="CCFFFFFF">common/blankWhite.png</texture>
		</control>
		<control type="label">
			<visible>Integer.IsEqual(Container(211).Position,4)</visible>
			<left>1460</left><top>323</top><width>190</width><height>52</height>
			<label>$INFO[Container(211).ListItem.Label]</label>
			<font>font13</font><textcolor>FF1A237E</textcolor>
			<align>center</align><aligny>center</aligny><scroll>false</scroll>
		</control>

		<control type="image">
			<visible>Integer.IsEqual(Container(211).Position,5)</visible>
			<left>1650</left><top>155</top><width>190</width><height>220</height>
			<texture border="5" colordiffuse="33FFFFFF">common/blankWhite.png</texture>
		</control>
		<control type="image">
			<visible>Integer.IsEqual(Container(211).Position,5)</visible>
			<left>1660</left><top>160</top><width>170</width><height>163</height>
			<texture fallback="DefaultShortcut.png">$INFO[Container(211).ListItem.Icon]</texture>
			<aspectratio>keep</aspectratio>
		</control>
		<control type="image">
			<visible>Integer.IsEqual(Container(211).Position,5)</visible>
			<left>1650</left><top>323</top><width>190</width><height>52</height>
			<texture colordiffuse="CCFFFFFF">common/blankWhite.png</texture>
		</control>
		<control type="label">
			<visible>Integer.IsEqual(Container(211).Position,5)</visible>
			<left>1650</left><top>323</top><width>190</width><height>52</height>
			<label>$INFO[Container(211).ListItem.Label]</label>
			<font>font13</font><textcolor>FF1A237E</textcolor>
			<align>center</align><aligny>center</aligny><scroll>false</scroll>
		</control>
	</include>

	<!-- Submenu thumbnail strip — display only.
	     All four nav directions redirect to list 211 so mouse clicks can never
	     strand focus here. itemlayout and focusedlayout are identical so there
	     is no visual "focused" state even if focus arrives via mouse.
	     aspectratio=keep preserves correct image proportions. -->
	<include name="SubmenuFixedListBase">
		<left>700</left>
		<top>220</top>
		<width>1160</width>
		<height>185</height>
		<orientation>horizontal</orientation>
		<onup>211</onup>
		<ondown>211</ondown>
		<onleft>211</onleft>
		<onright>211</onright>
		<hitrect x="0" y="0" w="0" h="0" />
		<include>SlideWithList211</include>
		<itemlayout width="150" height="185">
			<control type="image">
				<left>5</left>
				<top>2</top>
				<width>140</width>
				<height>140</height>
				<texture fallback="DefaultShortcut.png">$INFO[ListItem.Icon]</texture>
				<aspectratio>keep</aspectratio>
			</control>
			<control type="label">
				<left>2</left>
				<top>145</top>
				<width>146</width>
				<height>40</height>
				<label>$INFO[ListItem.Label]</label>
				<font>font13</font>
				<textcolor>AAFFFFFF</textcolor>
				<align>center</align>
				<aligny>center</aligny>
				<scroll>false</scroll>
			</control>
		</itemlayout>
		<focusedlayout width="150" height="185">
			<control type="image">
				<left>5</left>
				<top>2</top>
				<width>140</width>
				<height>140</height>
				<texture fallback="DefaultShortcut.png">$INFO[ListItem.Icon]</texture>
				<aspectratio>keep</aspectratio>
			</control>
			<control type="label">
				<left>2</left>
				<top>145</top>
				<width>146</width>
				<height>40</height>
				<label>$INFO[ListItem.Label]</label>
				<font>font13</font>
				<textcolor>AAFFFFFF</textcolor>
				<align>center</align>
				<aligny>center</aligny>
				<scroll>false</scroll>
			</control>
		</focusedlayout>
	</include>

</includes>