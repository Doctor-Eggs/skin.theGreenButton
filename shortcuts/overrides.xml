<?xml version="1.0" encoding="UTF-8"?>
<overrides>

	<group name="mainmenu" type="mainmenu" />

	<!-- focusId: all skin-shortcuts groups now share fixedlist 90000.
	     Hardcoded special lists (add-ons=90001, favourites=90016) keep their own IDs.
	     Fallback 0 = no submenu (e.g. play disc). -->
	<override group="mainmenu" defaultID="livetv">
		<property name="focusId">$NUMBER[90000]</property>
	</override>
	<override group="mainmenu" defaultID="videos">
		<property name="focusId">$NUMBER[90000]</property>
	</override>
	<override group="mainmenu" defaultID="movies">
		<property name="focusId">$NUMBER[90000]</property>
	</override>
	<override group="mainmenu" defaultID="tvshows">
		<property name="focusId">$NUMBER[90000]</property>
	</override>
	<override group="mainmenu" defaultID="music">
		<property name="focusId">$NUMBER[90000]</property>
	</override>
	<override group="mainmenu" defaultID="programs">
		<property name="focusId">$NUMBER[90001]</property>
	</override>
	<override group="mainmenu" defaultID="favourites">
		<property name="focusId">$NUMBER[90016]</property>
	</override>
	<override group="mainmenu" defaultID="settings">
		<property name="focusId">$NUMBER[90000]</property>
	</override>
	<override group="mainmenu" defaultID="weather">
		<property name="focusId">$NUMBER[90000]</property>
	</override>
	<override group="mainmenu" defaultID="pictures">
		<property name="focusId">$NUMBER[90000]</property>
	</override>
	<override group="mainmenu" defaultID="games">
		<property name="focusId">$NUMBER[90000]</property>
	</override>

	<propertyfallback property="focusId">$NUMBER[0]</propertyfallback>

