	<!-- ============================================================
	     focusedIcon + unfocusedIcon defaults: skin shortcuts reads these
	     via <propertydefault> and injects them into the generated
	     script-skinshortcuts-includes.xml for every user automatically.
	     focusedIcon is immune to cross-skin icon corruption because it
	     travels as a property, not the <icon> field.
	     ============================================================ -->

	<!-- Weather group -->
	<propertydefault group="weather" labelID="viewweather" property="focusedIcon">homeIcons/weather.png</propertydefault>
	<propertydefault group="weather" labelID="viewweather" property="unfocusedIcon">homeIcons/weatherNoFocus.png</propertydefault>

	<!-- Pictures group -->
	<propertydefault group="pictures" labelID="addpictures" property="focusedIcon">homeIcons/addPictures.png</propertydefault>
	<propertydefault group="pictures" labelID="addpictures" property="unfocusedIcon">homeIcons/addPicturesNoFocus.png</propertydefault>
